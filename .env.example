# Copie este arquivo para .env e preencha os valores

# URL do banco PostgreSQL (Railway preenche automaticamente)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Senha do admin (troque para algo seguro em produção)
ADMIN_PASS=senha123admin22

# Ambiente (deixe como production no Railway)
NODE_ENV=production

# Porta (Railway define automaticamente via variável PORT)
# PORT=3000
